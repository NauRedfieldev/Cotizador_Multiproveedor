SECRET_KEY=django-insecure-Example

DEBUG=True

NAME_DB=name_db
USER_DB=user_db
PASSWORD_DB=password_db
HOST_DB=localhost
PORT_DB=5432

# M6: máximo de ofertas devueltas por proveedor (entero positivo)
OFERTAS_POR_PROVEEDOR=10
# Tipo de cambio de SYSCOM que sugiere el comparador: normal (contado), preferencial, un_dia, una_semana, dos_semanas, tres_semanas, un_mes
SYSCOM_TIPO_CAMBIO_CAMPO=normal

# M8: opcional; volumen privado persistente, nunca una URL pública.
# QUOTE_PDF_ROOT=/ruta/privada/cconor/quotes

# M7a: datos de la empresa en las cotizaciones. Solo los nombres: los valores los valida CCONOR.
# Sin CCONOR_EMPRESA_NAME no se pueden crear cotizaciones.
CCONOR_EMPRESA_NAME=
CCONOR_EMPRESA_RFC=
CCONOR_EMPRESA_TAGLINE=
CCONOR_EMPRESA_PHONE=
CCONOR_EMPRESA_EMAIL=
# 5A: prefijo de los folios nuevos de CCONOR (2 a 6 letras mayúsculas; vacío = COT). Los ya creados no cambian.
CCONOR_EMPRESA_FOLIO_PREFIX=

# 5A: Torva Telecom, empresa hermana (opcional). Con NAME aparece «Cotizar como» en el cotizador.
# FOLIO_PREFIX: 2 a 6 letras mayúsculas, distinto del de CCONOR y de COT. LOGO: ruta dentro de static/.
TORVA_EMPRESA_NAME=
TORVA_EMPRESA_RFC=
TORVA_EMPRESA_TAGLINE=
TORVA_EMPRESA_PHONE=
TORVA_EMPRESA_EMAIL=
TORVA_EMPRESA_FOLIO_PREFIX=
TORVA_EMPRESA_LOGO=img/logo_torva.png

# M7a: dejar en False hasta que M8/CCONOR definan la política de precios de venta.
COTIZACIONES_EMISION_HABILITADA=False

# Proveedores con API: solo los nombres; los valores reales van en .env (nunca en git)
PROVIDER_SYSCOM_CLIENT_ID=
PROVIDER_SYSCOM_CLIENT_SECRET=
